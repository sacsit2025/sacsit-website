# deps / build
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# secrets - never tracked, no exceptions (.env.example holds names only, and the repo root's
# own .gitignore carries a blanket .env* - hence the negation, or the example would vanish)
.env
.env.local
.env*.local
!.env.example
*.pem
*.key

# the gated brochures: a gated file is never in public/ and never in git
documents/*
!documents/README.md

# os / editor
.DS_Store
Thumbs.db

# sacsit.com - every secret the site reads, and nobody who reads this file needs one.
#
# D88: the site is built locally with NO .env at all. Each variable below is OPTIONAL at runtime; a
# missing one degrades to a clearly-logged stub (mail skipped, sheet skipped, Turnstile accepted) and
# never to an error. Copy this file to .env.local for a local run, or paste the values into Vercel
# (Project - Settings - Environment Variables) for a preview and for production.
#
# NEVER put a value in this file. It is the only .env* file git tracks.

# ── mail · Resend (D90) ────────────────────────────────────────────────────────────────────────────
# The API key of the Resend account for sacsit.com. Created by DevOps in the Resend dashboard after
# the domain is verified there (SPF + DKIM records at Cloudflare, which keeps DNS per D17).
# Unset: the mail is skipped and the console says "resend: RESEND_API_KEY unset".
RESEND_API_KEY=
# Who the lead mail is addressed to. Unset: info@sacsit.com.
LEAD_TO=
# Who it is from - must be an address on a domain verified in Resend, or Resend refuses the send.
# Unset: "SACS-IT website <info@sacsit.com>".
LEAD_FROM=

# ── the sheet · Google (D92) ───────────────────────────────────────────────────────────────────────
# The spreadsheet that is the list of record. Karim creates the sheet in his Drive and shares it as
# EDITOR with the service account's e-mail; the id is the long string in the sheet's URL.
GOOGLE_SHEET_ID=
# The tab inside it. Unset: "leads". Row 1 of that tab is the header (lib/leads.ts SHEET_HEADER).
GOOGLE_SHEET_TAB=
# The service account, from its JSON key file: "client_email" and "private_key". DevOps creates the
# account in Google Cloud (IAM - Service Accounts), enables the Google Sheets API on the project, and
# downloads a JSON key. Paste the private key WITH its \n escapes, in quotes, exactly as the JSON has
# it - never the JSON file itself, and never the key into any other file.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ── the human check · Cloudflare Turnstile (D19) ───────────────────────────────────────────────────
# One widget, two halves of the same key pair, created by DevOps at Cloudflare (Turnstile - Add site,
# hostname sacsit.com plus the preview host). The site key is public and reaches the browser; the
# secret key never leaves the server.
# Both unset: no widget is drawn, the browser sends "dev-stub" and the server accepts it (local mode).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── the download links (D89) ───────────────────────────────────────────────────────────────────────
# Signs the fifteen-minute links to the eight gated PDFs. Any long random string - DevOps generates
# one (`openssl rand -hex 32`) and pastes it. REQUIRED in production: on Vercel the gate and the
# download are two functions with two memories, and an unset secret makes every link 404. Unset
# locally: a random one is minted per boot and the console says so.
LEAD_SIGNING_SECRET=

# ── analytics · Cloudflare Web Analytics (D20) ─────────────────────────────────────────────────────
# The beacon token, from the Cloudflare dashboard (Web Analytics - the site - the JS snippet). Public
# by design. Unset: no beacon loads at all, which is what a local run and a preview want.
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# ── the site's own address ─────────────────────────────────────────────────────────────────────────
# The canonical origin, used for absolute URLs in the metadata (sitemap, Open Graph). The preview
# project sets its Vercel URL; production sets https://www.sacsit.com. Unset: www.sacsit.com.
NEXT_PUBLIC_SITE_URL=
